<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily job board · {{ date }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f3ef;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f3ef;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;border:1px solid #e4e1d8;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f1e1b;">

  <tr><td style="padding:24px 24px 8px 24px;">
    <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#7a766b;">Daily job board · {{ date }}</div>
    <div style="font-size:22px;font-weight:700;margin-top:6px;line-height:1.3;">
      {% if owner %}{{ owner }}, here {{ 'is' if shown == 1 else 'are' }} {% endif %}{{ shown }} role{{ '' if shown == 1 else 's' }} posted in the last {{ hours }} hours
    </div>
    <div style="font-size:14px;color:#55524a;margin-top:6px;line-height:1.5;">
      Picked from {{ total }} role{{ '' if total == 1 else 's' }} that passed your filters on {{ health|length }} board{{ '' if health|length == 1 else 's' }}.
      {% if cross %}{{ cross }} {{ 'is' if cross == 1 else 'are' }} listed on more than one board, marked <span style="background:#e8f0ea;color:#24563a;border-radius:4px;padding:1px 6px;font-size:12px;font-weight:600;white-space:nowrap;">On N boards</span>.{% endif %}
      {% if not scored %}<br><b>Not scored:</b> fit notes were not added for this run.{% endif %}
    </div>
  </td></tr>

  {% for sec in sections %}
  <tr><td style="padding:20px 24px 4px 24px;">
    <div style="font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#7a4b12;border-bottom:2px solid #f0e2cc;padding-bottom:6px;">
      {{ sec.title }} <span style="color:#a8a397;font-weight:600;">· {{ sec.rows|length }}</span>
    </div>
  </td></tr>
  {% for r in sec.rows %}
  <tr><td style="padding:12px 24px;border-bottom:1px solid #f0eee8;">
    <div style="font-size:16px;font-weight:700;line-height:1.35;">
      <a href="{{ r.url }}" style="color:#1d4f8a;text-decoration:none;">{{ r.title }}</a>
      {% if r.lane %}<span style="background:#eef1f8;color:#2b3f73;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:600;white-space:nowrap;">{{ r.lane }}</span>{% endif %}
      {% if r.boards|length > 1 %}<span style="background:#e8f0ea;color:#24563a;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:600;white-space:nowrap;">On {{ r.boards|length }} boards</span>{% endif %}
    </div>
    <div style="font-size:14px;color:#33312c;margin-top:3px;line-height:1.45;">
      <b>{{ r.company }}</b>{% if r.location %} · {{ r.location }}{% endif %}{% if r.workplace and r.workplace not in (r.location or '') %} · {{ r.workplace }}{% endif %}{% if r.salary %} · {{ r.salary }}{% endif %}
    </div>
    {% set meta = [] %}
    {% if r.ago %}{% set _ = meta.append('Posted ' ~ r.ago) %}{% endif %}
    {% if r.applicants %}{% set _ = meta.append(r.applicants ~ ' on LinkedIn') %}{% endif %}
    {% if r.yoe %}{% set _ = meta.append('Asks ' ~ r.yoe) %}{% endif %}
    {% if r.employment_type %}{% set _ = meta.append(r.employment_type) %}{% endif %}
    {% if r.company_size %}{% set _ = meta.append(r.company_size ~ ' employees') %}{% endif %}
    {% if meta %}<div style="font-size:12px;color:#7a766b;margin-top:4px;line-height:1.5;">{{ meta|join(' · ') }}</div>{% endif %}
    {% if r.why %}<div style="font-size:14px;color:#1f1e1b;margin-top:6px;line-height:1.5;">{{ r.why }}</div>{% endif %}
    {% if r.pipeline %}<div style="font-size:12px;color:#8a5a00;margin-top:4px;">{{ r.pipeline }}</div>{% endif %}
    {% if r.below_pay_target %}<div style="font-size:12px;color:#8a5a00;margin-top:4px;">Listed pay is below your target.</div>{% endif %}
    <div style="font-size:12px;color:#7a766b;margin-top:5px;">
      Seen on:
      {% for b in r.boards %}<a href="{{ b.url }}" style="color:#1d4f8a;">{{ b.label }}</a>{% if b.postings > 1 %} ({{ b.postings }} postings){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
  </td></tr>
  {% endfor %}
  {% endfor %}

  {% if not sections %}
  <tr><td style="padding:24px;font-size:15px;color:#55524a;">No roles matched today. The board checks are listed below.</td></tr>
  {% endif %}

  <tr><td style="padding:20px 24px 24px 24px;">
    <div style="font-size:12px;color:#7a766b;line-height:1.6;border-top:1px solid #e4e1d8;padding-top:12px;">
      <b style="color:#55524a;">Board checks</b><br>
      {% for h in health %}
      {{ h.label }}: {% if h.status == 'done' %}{{ h.jobs }} matched of {{ h.scanned or '?' }} scanned{% else %}<span style="color:#a33a1f;">{{ h.status }}{% if h.error %} ({{ h.error }}){% endif %}{% if h.log %}: {{ h.log[0] }}{% endif %}</span>{% endif %}<br>
      {% endfor %}
      Generated by daily-job-board. Postings come from public listing pages and may be stale or reposted; check the link before applying.
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
